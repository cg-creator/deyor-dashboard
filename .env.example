# Copy to .env.local and fill before building
# CRA requires REACT_APP_ prefix for envs to be embedded at build time
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
REACT_APP_SITE_URL=http://localhost:3000
# Optional debugging for data API
# REACT_APP_DEBUG_DATAAPI=true

# Optional: webhook(s) to notify admin on signup/forgot-password
# Point these to a Zapier/Make webhook or your own endpoint.
REACT_APP_APPROVAL_WEBHOOK_URL=
